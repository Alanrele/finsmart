// Esquema PostgreSQL de FinSmart (migrado desde MongoDB/Mongoose)
// DATABASE_URL: cadena de conexión de Railway Postgres (o local para desarrollo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  firstName     String
  lastName      String
  microsoftId   String?       @unique
  accessToken   String?
  refreshToken  String?
  tokenExpiry   DateTime?
  isVerified    Boolean       @default(false)
  // { theme, currency, notifications: { email, push } } — mismo shape que en Mongo
  preferences   Json          @default("{\"theme\":\"dark\",\"currency\":\"PEN\",\"notifications\":{\"email\":true,\"push\":true}}")
  lastSync      DateTime?
  lastReprocess DateTime?
  syncEnabled   Boolean       @default(false)
  isDemo        Boolean       @default(false)
  // Membresía Platinum + trial único de 7 días (gating validado en servidor)
  esPlatinum      Boolean   @default(false) @map("es_platinum")
  trialUsado      Boolean   @default(false) @map("trial_usado")
  trialIniciadoEn DateTime? @map("trial_iniciado_en")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  rules         ClassificationRule[]
  categories    Category[]
  pdfCredentials PdfCredential[]
  emailReviews  EmailReview[]

  @@map("users")
}

/*
  Bandeja de revisión de correos NO procesables: cuando al correo del BCP le
  falta una etiqueta esperada o el parser falla, NO se inventa nada — el
  correo queda aquí para revisión manual y se notifica al usuario.
*/
model EmailReview {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId  String    // id del mensaje en el proveedor de correo
  subject    String?
  receivedAt DateTime?
  reason     String    // qué faltó o qué falló (ej. "faltan: fecha, comercio")
  snippet    String?   // fragmento del cuerpo para diagnóstico (truncado)
  status     String    @default("pending") // pending | dismissed
  createdAt  DateTime  @default(now())

  @@unique([userId, messageId])
  @@map("email_reviews")
}

// Rubro/categoría del catálogo (editable por el usuario)
model Category {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // estable, se guarda en Transaction.category
  label     String
  kind      String   @default("expense") // income | expense | both
  color     String   @default("#71717A")
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("categories")
}

// Regla determinística de clasificación por rubro (motor SIN IA)
model ClassificationRule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String   // key del rubro destino
  matchType String   @default("keyword") // keyword | regex
  pattern   String
  field     String   @default("all")     // description | merchant | all
  priority  Int      @default(100)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, priority])
  @@map("classification_rules")
}

// Credencial (contraseña) de PDF cifrada con AES-256-GCM. NUNCA en texto plano.
model PdfCredential {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // nombre visible dado por el usuario (p. ej. "BCP marzo")
  // { v, iv, tag, data } — blob cifrado; sin contraseña en claro
  cipher    Json
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pdf_credentials")
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId       String   @unique
  amount          Float
  currency        String   @default("PEN")
  // Valores validados en la capa de aplicación (enums heredados de Mongoose):
  // type: debit|credit|transfer|payment|withdrawal|deposit
  // category: food|transport|entertainment|shopping|healthcare|utilities|education|travel|investment|income|transfer|other
  // channel: online|atm|pos|mobile|branch|other
  type            String
  category        String    @default("other")
  subcategory     String?
  merchant        String?
  description     String
  channel         String    @default("other")
  operationNumber String?
  cardNumber      String?
  date            DateTime
  balance         Float?
  location        String?
  rawText         String
  isProcessed     Boolean   @default(false)
  // { confidence, insights[], recommendations[] }
  aiAnalysis      Json?
  notes           String?
  reprocessCount  Int       @default(0)
  lastUpdated     DateTime?
  // Origen del dato y deduplicación (bloques PDF + reglas)
  origin          String    @default("email") // email | pdf
  sourceFile      String?   // nombre del PDF de origen, si aplica
  account         String?   // cuenta/tarjeta de origen
  dedupeHash      String?   // huella fecha+monto+desc-normalizada+cuenta
  // Campo "Empresa" tal como llegó en el correo BCP (trazabilidad); el campo
  // `merchant` guarda la versión normalizada que consume el motor de reglas
  merchantRaw     String?   @map("merchant_raw")
  ruleId          String?   // regla que clasificó el movimiento (audita el porqué)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, date(sort: Desc)])
  @@index([userId, category])
  @@index([userId, type])
  @@index([userId, operationNumber])
  @@index([userId, dedupeHash])
  @@map("transactions")
}
